<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>FeatureLab</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>disable</Nullable>
    <NuGetAudit>false</NuGetAudit>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <StardustBin Condition="'$(StardustBin)' == ''">$(MSBuildThisFileDirectory)..\..\build\bin\Release</StardustBin>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Assets/**/*.cs;Packages/**/*.cs" Exclude="Assets/**/Editor/**/*.cs" />
    <Reference Include="Stardust.ScriptCore"><HintPath>$(StardustBin)\Stardust.ScriptCore.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
