<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Stardust.ScriptCore</AssemblyName>
    <RootNamespace>Stardust</RootNamespace>
    <!-- Kept in step with the engine; CMake passes the version from CMakeLists.txt -->
    <Version>0.6.6</Version>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Required for native hosting: produces Stardust.ScriptCore.runtimeconfig.json -->
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Stardust.ScriptCore.xml: the /// summaries shown by the Script Editor when hovering a name -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573;CS1572;CS1587;CS1574;CS1570;CS1734</NoWarn>
  </PropertyGroup>

</Project>
